// Readout color formulas shared by the CPU's float/double instances and the
// generated Metal source. The includer supplies ANALYSIS_REAL and
// ANALYSIS_LITERAL; the latter preserves float literals for Metal/FP32 while
// leaving unsuffixed decimal values as double for the measurement path.
ANALYSIS_MATH_SOURCE(
inline ANALYSIS_REAL srgb_encode(ANALYSIS_REAL x) {
  ANALYSIS_REAL v=x<ANALYSIS_LITERAL(0.0)?-x:x;
  ANALYSIS_REAL e=v<=ANALYSIS_LITERAL(0.0031308)?ANALYSIS_LITERAL(12.92)*v:ANALYSIS_LITERAL(1.055)*a_pow(v,ANALYSIS_LITERAL(1.0)/ANALYSIS_LITERAL(2.4))-ANALYSIS_LITERAL(0.055);
  return a_copysign(e,x);
}
inline ANALYSIS_REAL srgb_decode(ANALYSIS_REAL x) {
  ANALYSIS_REAL v=x<ANALYSIS_LITERAL(0.0)?-x:x;
  ANALYSIS_REAL e=v<=ANALYSIS_LITERAL(0.04045)?v/ANALYSIS_LITERAL(12.92):a_pow((v+ANALYSIS_LITERAL(0.055))/ANALYSIS_LITERAL(1.055),ANALYSIS_LITERAL(2.4));
  return a_copysign(e,x);
}
inline ANALYSIS_REAL pq_encode(ANALYSIS_REAL nit) {
  ANALYSIS_REAL p=a_pow(bound(nit,ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(10000.0))/ANALYSIS_LITERAL(10000.0),ANALYSIS_LITERAL(2610.0)/ANALYSIS_LITERAL(16384.0));
  return a_pow((ANALYSIS_LITERAL(3424.0)/ANALYSIS_LITERAL(4096.0)+(ANALYSIS_LITERAL(2413.0)/ANALYSIS_LITERAL(128.0))*p)/(ANALYSIS_LITERAL(1.0)+(ANALYSIS_LITERAL(2392.0)/ANALYSIS_LITERAL(128.0))*p),ANALYSIS_LITERAL(2523.0)/ANALYSIS_LITERAL(32.0));
}
inline ANALYSIS_REAL pq_decode(ANALYSIS_REAL signal) {
  ANALYSIS_REAL p=a_pow(bound(signal,ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(1.0)),ANALYSIS_LITERAL(32.0)/ANALYSIS_LITERAL(2523.0));
  return ANALYSIS_LITERAL(10000.0)*a_pow(bound(p-ANALYSIS_LITERAL(3424.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(1.0))/((ANALYSIS_LITERAL(2413.0)/ANALYSIS_LITERAL(128.0))-(ANALYSIS_LITERAL(2392.0)/ANALYSIS_LITERAL(128.0))*p),ANALYSIS_LITERAL(16384.0)/ANALYSIS_LITERAL(2610.0));
}
inline A3 xyz_from_rgb(A3 v, unsigned int gamut) {
  if(gamut==0u) return a3(
    dot3(a3(ANALYSIS_LITERAL(0.4123907992659595),ANALYSIS_LITERAL(0.3575843393838780),ANALYSIS_LITERAL(0.1804807884018343)),v),
    dot3(a3(ANALYSIS_LITERAL(0.2126390058715104),ANALYSIS_LITERAL(0.7151686787677560),ANALYSIS_LITERAL(0.0721923153607337)),v),
    dot3(a3(ANALYSIS_LITERAL(0.0193308187155918),ANALYSIS_LITERAL(0.1191947797946260),ANALYSIS_LITERAL(0.9505321522496607)),v));
  if(gamut==2u) return a3(
    dot3(a3(ANALYSIS_LITERAL(0.6369580483012914),ANALYSIS_LITERAL(0.1446169035862083),ANALYSIS_LITERAL(0.1688809751641721)),v),
    dot3(a3(ANALYSIS_LITERAL(0.2627002120112671),ANALYSIS_LITERAL(0.6779980715188708),ANALYSIS_LITERAL(0.0593017164698620)),v),
    dot3(a3(ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(0.0280726930490874),ANALYSIS_LITERAL(1.0609850577107910)),v));
  return a3(
    dot3(a3(ANALYSIS_LITERAL(0.4865709486482162),ANALYSIS_LITERAL(0.2656676931690931),ANALYSIS_LITERAL(0.1982172852343625)),v),
    dot3(a3(ANALYSIS_LITERAL(0.2289745640697488),ANALYSIS_LITERAL(0.6917385218365064),ANALYSIS_LITERAL(0.0792869140937450)),v),
    dot3(a3(ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(0.0451133818589026),ANALYSIS_LITERAL(1.0439443689009757)),v));
}
inline A3 rgb_from_xyz(A3 v,unsigned int gamut) {
  if(gamut==0u) return a3(
    dot3(a3(ANALYSIS_LITERAL(3.2409699419045226),ANALYSIS_LITERAL(-1.5373831775700940),ANALYSIS_LITERAL(-0.4986107602930034)),v),
    dot3(a3(ANALYSIS_LITERAL(-0.9692436362808796),ANALYSIS_LITERAL(1.8759675015077202),ANALYSIS_LITERAL(0.0415550574071756)),v),
    dot3(a3(ANALYSIS_LITERAL(0.0556300796969937),ANALYSIS_LITERAL(-0.2039769588889765),ANALYSIS_LITERAL(1.0569715142428786)),v));
  if(gamut==2u) return a3(
    dot3(a3(ANALYSIS_LITERAL(1.716651187971268),ANALYSIS_LITERAL(-0.355670783776392),ANALYSIS_LITERAL(-0.253366281373660)),v),
    dot3(a3(ANALYSIS_LITERAL(-0.666684351832489),ANALYSIS_LITERAL(1.616481236634939),ANALYSIS_LITERAL(0.015768545813911)),v),
    dot3(a3(ANALYSIS_LITERAL(0.017639857445311),ANALYSIS_LITERAL(-0.042770613257809),ANALYSIS_LITERAL(0.942103121235474)),v));
  return a3(
    dot3(a3(ANALYSIS_LITERAL(2.493496911941425),ANALYSIS_LITERAL(-0.931383617919124),ANALYSIS_LITERAL(-0.402710784450717)),v),
    dot3(a3(ANALYSIS_LITERAL(-0.829488969561575),ANALYSIS_LITERAL(1.762664060318346),ANALYSIS_LITERAL(0.023624685841944)),v),
    dot3(a3(ANALYSIS_LITERAL(0.035845830243784),ANALYSIS_LITERAL(-0.076172389268041),ANALYSIS_LITERAL(0.956884524007687)),v));
}
inline unsigned int working_gamut(unsigned int space) { return space==0u?0u:(space==3u?2u:1u); }
inline A3 y_coefficients(unsigned int gamut) { return a3(
  xyz_from_rgb(a3(1,0,0),gamut).y,xyz_from_rgb(a3(0,1,0),gamut).y,xyz_from_rgb(a3(0,0,1),gamut).y); }
inline A3 lms_from_rgb(A3 v,unsigned int gamut) {
  if(gamut==1u) return a3(
    dot3(a3(ANALYSIS_LITERAL(0.334550623220059),ANALYSIS_LITERAL(0.576391094387109),ANALYSIS_LITERAL(0.089058282392832)),v),
    dot3(a3(ANALYSIS_LITERAL(0.158520235234873),ANALYSIS_LITERAL(0.713612932646569),ANALYSIS_LITERAL(0.127866832118557)),v),
    dot3(a3(ANALYSIS_LITERAL(0.020581197388829),ANALYSIS_LITERAL(0.091695662564561),ANALYSIS_LITERAL(0.887723140046610)),v));
  if(gamut!=2u) v=rgb_from_xyz(xyz_from_rgb(v,gamut),2u);
  return a3(dot3(a3(ANALYSIS_LITERAL(1688.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(2146.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(262.0)/ANALYSIS_LITERAL(4096.0)),v),
    dot3(a3(ANALYSIS_LITERAL(683.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(2951.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(462.0)/ANALYSIS_LITERAL(4096.0)),v),
    dot3(a3(ANALYSIS_LITERAL(99.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(309.0)/ANALYSIS_LITERAL(4096.0),ANALYSIS_LITERAL(3688.0)/ANALYSIS_LITERAL(4096.0)),v));
}
inline A3 itp_from_lms(A3 v) {
  A3 p=a3(pq_encode(v.x),pq_encode(v.y),pq_encode(v.z));
  ANALYSIS_REAL lm=p.x-p.y,sm=p.z-p.y;
  return a3(ANALYSIS_LITERAL(0.5)*(p.x+p.y),
    (ANALYSIS_LITERAL(6610.0)*lm+ANALYSIS_LITERAL(7003.0)*sm)/ANALYSIS_LITERAL(8192.0),
    (ANALYSIS_LITERAL(17933.0)*lm-ANALYSIS_LITERAL(543.0)*sm)/ANALYSIS_LITERAL(4096.0));
}
inline ANALYSIS_REAL lab_f(ANALYSIS_REAL v) { return v>ANALYSIS_LITERAL(216.0)/ANALYSIS_LITERAL(24389.0)?a_pow(v,ANALYSIS_LITERAL(1.0)/ANALYSIS_LITERAL(3.0)):(ANALYSIS_LITERAL(24389.0)/ANALYSIS_LITERAL(27.0)*v+ANALYSIS_LITERAL(16.0))/ANALYSIS_LITERAL(116.0); }
inline A3 lab_from_xyz(A3 v) {
  ANALYSIS_REAL x=lab_f(v.x/ANALYSIS_LITERAL(0.9504559270516716)), y=lab_f(v.y), z=lab_f(v.z/ANALYSIS_LITERAL(1.0890577507598784));
  return a3(ANALYSIS_LITERAL(116.0)*y-ANALYSIS_LITERAL(16.0),ANALYSIS_LITERAL(500.0)*(x-y),ANALYSIS_LITERAL(200.0)*(y-z));
}
inline A3 ncl_from_signal(A3 s,unsigned int gamut) {
  A3 k=y_coefficients(gamut); ANALYSIS_REAL y=dot3(k,s);
  return a3(y,(s.z-y)/(ANALYSIS_LITERAL(2.0)*(ANALYSIS_LITERAL(1.0)-k.z)),(s.x-y)/(ANALYSIS_LITERAL(2.0)*(ANALYSIS_LITERAL(1.0)-k.x)));
}
inline ANALYSIS_REAL adobe_coordinate(ANALYSIS_REAL edr) {
  if(edr<=ANALYSIS_LITERAL(1.0)) return (ANALYSIS_LITERAL(4.0)/ANALYSIS_LITERAL(9.0))*srgb_encode(bound(edr,ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(1.0)));
  return ANALYSIS_LITERAL(4.0)/ANALYSIS_LITERAL(9.0)+a_log2(edr)/ANALYSIS_LITERAL(9.0);
}
inline ANALYSIS_REAL adobe_axis(ANALYSIS_REAL edr) { return bound(adobe_coordinate(edr),ANALYSIS_LITERAL(0.0),ANALYSIS_LITERAL(1.0)); }
inline ANALYSIS_REAL adobe_inverse(ANALYSIS_REAL u) { return u<=ANALYSIS_LITERAL(4.0)/ANALYSIS_LITERAL(9.0)?srgb_decode(u*ANALYSIS_LITERAL(9.0)/ANALYSIS_LITERAL(4.0)):a_pow(ANALYSIS_LITERAL(2.0),u*ANALYSIS_LITERAL(9.0)-ANALYSIS_LITERAL(4.0)); }
inline ANALYSIS_REAL hue_degrees(ANALYSIS_REAL x,ANALYSIS_REAL y) {
  ANALYSIS_REAL angle=a_atan2(y,x)*ANALYSIS_LITERAL(57.29577951308232);
  if(angle<ANALYSIS_LITERAL(0.0)) angle+=ANALYSIS_LITERAL(360.0);
  return angle>=ANALYSIS_LITERAL(360.0)?ANALYSIS_LITERAL(0.0):angle;
}
inline bool hue_defined(ANALYSIS_REAL chroma,unsigned int space) {
  return a_finite(chroma)&&chroma>(space>=2u?ANALYSIS_LITERAL(1.0)/ANALYSIS_LITERAL(720.0):ANALYSIS_LITERAL(1.0));
}
struct Signals {
  A3 encoded; A3 perceptual; A3 ncl; A3 adobe;
  ANALYSIS_REAL y_nit; ANALYSIS_REAL intensity; ANALYSIS_REAL hue; ANALYSIS_REAL chroma;
  bool valid; bool hue_valid;
};
inline Signals signals_from_work(A3 w,unsigned int space,ANALYSIS_REAL white) {
  Signals out{}; out.valid=finite3(w); if(!out.valid) return out;
  unsigned int gamut=working_gamut(space);
  out.y_nit=dot3(y_coefficients(gamut),w)*white;
  if(space>=2u) {
    A3 a=scale3(w,white),lms=lms_from_rgb(a,gamut);
    out.valid=finite3(lms)&&lms.x>=ANALYSIS_LITERAL(0.0)&&lms.y>=ANALYSIS_LITERAL(0.0)&&lms.z>=ANALYSIS_LITERAL(0.0);
    if(!out.valid) return out;
    out.encoded=a3(pq_encode(a.x),pq_encode(a.y),pq_encode(a.z));
    out.perceptual=itp_from_lms(lms); out.intensity=out.perceptual.x;
  } else {
    out.encoded=a3(srgb_encode(w.x),srgb_encode(w.y),srgb_encode(w.z));
    out.perceptual=lab_from_xyz(xyz_from_rgb(w,gamut));
    out.intensity=dot3(y_coefficients(gamut),out.encoded);
  }
  out.ncl=ncl_from_signal(out.encoded,gamut);
  out.adobe=a3(adobe_axis(w.x),adobe_axis(w.y),adobe_axis(w.z));
  out.chroma=a_sqrt(out.perceptual.y*out.perceptual.y+out.perceptual.z*out.perceptual.z);
  out.hue_valid=hue_defined(out.chroma,space);
  out.hue=out.hue_valid?hue_degrees(out.perceptual.y,out.perceptual.z):ANALYSIS_LITERAL(0.0);
  return out;
}
