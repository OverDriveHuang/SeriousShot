set(HDRSHOT_UPDATE_CHANNEL "stable" CACHE STRING "stable or isolated testing")
set(HDRSHOT_UPDATE_PUBLIC_KEY "" CACHE STRING "Release Ed25519 public key, 64 lowercase hex characters; empty fails closed")
set(HDRSHOT_UPDATE_KEY_ID "" CACHE STRING "Release signing key identity")
option(HDRSHOT_UPDATE_TESTING "Explicit isolated testing trust build" OFF)
option(HDRSHOT_WINDOWS_UPDATE_NATIVE_VALIDATED "Enable Windows automatic install only after native F1 race gates" OFF)
if(NOT HDRSHOT_UPDATE_CHANNEL STREQUAL "stable" AND NOT HDRSHOT_UPDATE_TESTING)
  message(FATAL_ERROR "Non-stable update trust requires an isolated testing build")
endif()
if(HDRSHOT_UPDATE_PUBLIC_KEY AND NOT HDRSHOT_UPDATE_PUBLIC_KEY MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Invalid update public key")
endif()
add_library(hdrshot_update_policy STATIC src/domain/update/update_policy.cpp src/application/update_coordinator.cpp)
target_link_libraries(hdrshot_update_policy PUBLIC hdrshot_core)
target_include_directories(hdrshot_update_policy PUBLIC src)
hdrshot_enable_warnings(hdrshot_update_policy)
add_library(hdrshot_qt_update_ui STATIC src/ui/qt/update_window.cpp)
target_link_libraries(hdrshot_qt_update_ui PUBLIC hdrshot_update_policy Qt6::Widgets)
target_include_directories(hdrshot_qt_update_ui PUBLIC src)
add_library(hdrshot_qt_update STATIC
  src/platform/qt/update/update_storage.cpp src/platform/qt/update/update_catalog.cpp
  src/platform/qt/update/qt_update_runtime.cpp src/platform/qt/update/update_package.cpp)
target_link_libraries(hdrshot_qt_update PUBLIC hdrshot_update_policy hdrshot_qt_update_ui hdrshot_sodium archive_static ZLIB::ZLIB Qt6::Network Qt6::Widgets)
target_include_directories(hdrshot_qt_update PUBLIC src)
target_compile_definitions(hdrshot_qt_update PUBLIC
  HDRSHOT_UPDATE_PUBLIC_KEY="${HDRSHOT_UPDATE_PUBLIC_KEY}"
  HDRSHOT_UPDATE_KEY_ID="${HDRSHOT_UPDATE_KEY_ID}"
  HDRSHOT_UPDATE_CHANNEL="${HDRSHOT_UPDATE_CHANNEL}"
  HDRSHOT_UPDATE_TESTING=$<BOOL:${HDRSHOT_UPDATE_TESTING}>
  HDRSHOT_UPDATE_CATALOG="https://raw.githubusercontent.com/OverDriveHuang/SeriousShot/main/updates/${HDRSHOT_UPDATE_CHANNEL}.json"
  HDRSHOT_WINDOWS_UPDATE_NATIVE_VALIDATED=$<BOOL:${HDRSHOT_WINDOWS_UPDATE_NATIVE_VALIDATED}>)
if(APPLE)
  target_sources(hdrshot_qt_update PRIVATE src/platform/macos/update/macos_update_backend.cpp)
elseif(WIN32)
  target_sources(hdrshot_qt_update PRIVATE src/platform/windows/update/windows_update_backend.cpp)
  target_link_libraries(hdrshot_qt_update PRIVATE psapi shell32)
endif()
# settings UI is intentionally not a dependency of this service (avoid a cycle).
# final applications link both UI and service.

if(WIN32)
  add_executable(hdrshot_windows_update_helper tools/update/windows_update_helper.cpp)
  set_target_properties(hdrshot_windows_update_helper PROPERTIES OUTPUT_NAME SeriousShotUpdater)
  target_link_libraries(hdrshot_windows_update_helper PRIVATE hdrshot_qt_update psapi shell32)
  target_compile_definitions(hdrshot_qt_update PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_definitions(hdrshot_windows_update_helper PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
if(BUILD_TESTING)
  add_executable(hdrshot_update_tests tests/update/update_tests.cpp)
  target_link_libraries(hdrshot_update_tests PRIVATE hdrshot_qt_update hdrshot_qt_settings)
  target_include_directories(hdrshot_update_tests PRIVATE tests)
  add_test(NAME hdrshot_update_tests COMMAND hdrshot_update_tests)
  set_tests_properties(hdrshot_update_tests PROPERTIES TIMEOUT 90)
endif()
add_executable(hdrshot_update_catalog_tool tools/update/update_catalog_tool.cpp)
target_link_libraries(hdrshot_update_catalog_tool PRIVATE hdrshot_qt_update hdrshot_qt_settings)
if(APPLE AND BUILD_TESTING)
  add_executable(hdrshot_macos_update_integration tests/update/macos_update_integration.cpp)
  target_link_libraries(hdrshot_macos_update_integration PRIVATE hdrshot_qt_update hdrshot_qt_settings)
  # Opt-in native mounting integration; not silently skipped or called by portable CTest.
endif()
if(BUILD_TESTING)
  add_executable(hdrshot_update_runtime_tests tests/update/update_runtime_tests.cpp)
  target_link_libraries(hdrshot_update_runtime_tests PRIVATE hdrshot_qt_update hdrshot_qt_settings)
  target_include_directories(hdrshot_update_runtime_tests PRIVATE tests)
  add_test(NAME hdrshot_update_runtime_tests COMMAND hdrshot_update_runtime_tests)
  set_tests_properties(hdrshot_update_runtime_tests PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 90)
endif()
add_executable(hdrshot_update_network_probe tools/update/update_network_probe.cpp)
target_link_libraries(hdrshot_update_network_probe PRIVATE Qt6::Network)
