target_include_directories(hdrshot_windows_color PUBLIC src)
hdrshot_enable_warnings(hdrshot_windows_color)
add_library(hdrshot_windows_capture STATIC src/platform/windows/windows_capture.cpp)
target_link_libraries(hdrshot_windows_capture PUBLIC hdrshot_windows_color PRIVATE d3d11 dxgi windowsapp shcore gdi32)
target_compile_definitions(hdrshot_windows_capture PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
hdrshot_enable_warnings(hdrshot_windows_capture)
