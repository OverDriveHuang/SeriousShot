add_library(hdrshot_windows_d3d_export STATIC src/platform/windows/windows_d3d_export.cpp)
target_link_libraries(hdrshot_windows_d3d_export PUBLIC hdrshot_windows_color PRIVATE d3d11 dxgi d3dcompiler windowsapp)
target_compile_definitions(hdrshot_windows_d3d_export PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
hdrshot_enable_warnings(hdrshot_windows_d3d_export)
add_library(hdrshot_windows_d3d_presenter STATIC src/platform/windows/windows_d3d_presenter.cpp)
