  target_compile_definitions(hdrshot_windows_qt_ports PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  hdrshot_enable_warnings(hdrshot_windows_qt_ports)
  add_executable(hdrshot_windows_app WIN32 tools/windows_app.cpp)
  add_executable(hdrshot_windows_icon_writer tools/windows_icon_writer.cpp)
  target_include_directories(hdrshot_windows_icon_writer PRIVATE src)
  target_link_libraries(hdrshot_windows_icon_writer PRIVATE Qt6::Widgets)
  set(_hdrshot_windows_icon "${CMAKE_CURRENT_BINARY_DIR}/generated/SeriousShot.ico")
  add_custom_command(OUTPUT "${_hdrshot_windows_icon}"
      COMMAND ${CMAKE_COMMAND} -E env "QT_QPA_PLATFORM=offscreen"
          "PATH=$<TARGET_FILE_DIR:Qt6::Core>\;$ENV{PATH}"
          $<TARGET_FILE:hdrshot_windows_icon_writer> "${_hdrshot_windows_icon}"
      DEPENDS hdrshot_windows_icon_writer VERBATIM)
  add_custom_target(hdrshot_windows_icon DEPENDS "${_hdrshot_windows_icon}")
  add_dependencies(hdrshot_windows_app hdrshot_windows_icon)
  set(_hdrshot_windows_rc "${CMAKE_CURRENT_BINARY_DIR}/generated/windows_app.rc")
  file(WRITE "${_hdrshot_windows_rc}" "1 ICON \"${_hdrshot_windows_icon}\"\n")
  set_source_files_properties("${_hdrshot_windows_rc}" PROPERTIES OBJECT_DEPENDS "${_hdrshot_windows_icon}")
  target_sources(hdrshot_windows_app PRIVATE "${_hdrshot_windows_rc}")
  set_target_properties(hdrshot_windows_app PROPERTIES OUTPUT_NAME SeriousShot)
  target_link_libraries(hdrshot_windows_app PRIVATE hdrshot_windows_qt_ports hdrshot_windows_d3d_export
      hdrshot_windows_d3d_presenter hdrshot_capture_session hdrshot_interaction_controller
      hdrshot_multi_display_preview hdrshot_export_workflow hdrshot_ultra_hdr_codec
      hdrshot_qt_overlay_ui hdrshot_qt_settings hdrshot_qt_diagnostics hdrshot_freetype_text_rasterizer Qt6::Widgets)
  target_compile_definitions(hdrshot_windows_app PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  hdrshot_enable_warnings(hdrshot_windows_app)
  add_custom_command(TARGET hdrshot_windows_app POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:hdrshot_windows_app>/assets/fonts"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/assets/fonts/NotoSansSC-VF.ttf"
          "$<TARGET_FILE_DIR:hdrshot_windows_app>/assets/fonts/NotoSansSC-VF.ttf")
  if(BUILD_TESTING)
    add_executable(hdrshot_windows_qt_ports_tests tests/windows_qt_ports_tests.cpp)
    target_link_libraries(hdrshot_windows_qt_ports_tests PRIVATE hdrshot_windows_qt_ports shell32)
    target_include_directories(hdrshot_windows_qt_ports_tests PRIVATE tests)
    target_compile_definitions(hdrshot_windows_qt_ports_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    hdrshot_enable_warnings(hdrshot_windows_qt_ports_tests)
    add_test(NAME hdrshot_windows_qt_ports_tests COMMAND hdrshot_windows_qt_ports_tests)
    set_tests_properties(hdrshot_windows_qt_ports_tests PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=windows")
  endif()
endif()
