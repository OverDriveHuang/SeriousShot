# Upstream release, including the Ed25519 subgroup validation fixes.
include(ExternalProject)
set(HDRSHOT_SODIUM_VERSION "1.0.22")
set(HDRSHOT_SODIUM_SHA256 "adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349")
set(HDRSHOT_SODIUM_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.build-tools/libsodium-install" CACHE PATH "Pinned libsodium install (built by scripts/build_update_dependencies.py)")
if(NOT EXISTS "${HDRSHOT_SODIUM_ROOT}/include/sodium.h")
  message(FATAL_ERROR "Build pinned libsodium first: python3 scripts/build_update_dependencies.py")
endif()
if(WIN32)
  set(HDRSHOT_SODIUM_LIBRARY "${HDRSHOT_SODIUM_ROOT}/lib/libsodium.lib")
else()
  set(HDRSHOT_SODIUM_LIBRARY "${HDRSHOT_SODIUM_ROOT}/lib/libsodium.a")
endif()
if(NOT EXISTS "${HDRSHOT_SODIUM_LIBRARY}")
  message(FATAL_ERROR "Missing pinned libsodium library: ${HDRSHOT_SODIUM_LIBRARY}")
endif()
file(READ "${HDRSHOT_SODIUM_ROOT}/include/sodium/version.h" _sodium_version)
if(NOT _sodium_version MATCHES "SODIUM_VERSION_STRING \"1.0.22\"")
  message(FATAL_ERROR "Updater requires pinned libsodium 1.0.22")
endif()
add_library(hdrshot_sodium STATIC IMPORTED GLOBAL)
set_target_properties(hdrshot_sodium PROPERTIES IMPORTED_LOCATION "${HDRSHOT_SODIUM_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${HDRSHOT_SODIUM_ROOT}/include"
  INTERFACE_COMPILE_DEFINITIONS SODIUM_STATIC)
set(HDRSHOT_ARCHIVE_VERSION "3.8.9")
set(HDRSHOT_ARCHIVE_SHA256 "888c934f9d95648ecb9163dc8e23ab80a476ecb81a8f1154704a227b5b676dde")
set(HDRSHOT_ARCHIVE_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/.build-tools/libarchive-3.8.9")
if(NOT EXISTS "${HDRSHOT_ARCHIVE_SOURCE}/CMakeLists.txt")
  message(FATAL_ERROR "Build update dependencies first: python3 scripts/build_update_dependencies.py")
endif()
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/.build-tools/libarchive-3.8.9.tar.xz" _archive_hash)
if(NOT _archive_hash STREQUAL HDRSHOT_ARCHIVE_SHA256)
  message(FATAL_ERROR "libarchive source archive hash mismatch")
endif()
foreach(feature OPENSSL MBEDTLS NETTLE LIBB2 LZMA LZO LZ4 ZSTD BZip2 LIBXML2 EXPAT ICONV CNG TEST TAR CPIO CAT UNZIP INSTALL)
  set(ENABLE_${feature} OFF CACHE BOOL "Updater only needs bounded ZIP/deflate" FORCE)
endforeach()
set(ENABLE_ZLIB ON CACHE BOOL "" FORCE)
add_subdirectory("${HDRSHOT_ARCHIVE_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/update-libarchive" EXCLUDE_FROM_ALL)
target_compile_definitions(archive_static INTERFACE LIBARCHIVE_STATIC)
if(MSVC)
  set_property(TARGET archive_static PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
endif()
